{
  "info": {
    "name": "Cultural Events API (fase 1)",
    "description": "Fluxo ponta a ponta e cenários de erro da fase 1. Rode a pasta 'Fluxo ponta a ponta' em ordem (Collection Runner); depois 'Cenários de erro'. Requer a pasta 1 já executada para cityId/categoryId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "cityId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "venueId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "eventVersion",
      "value": ""
    },
    {
      "key": "staleVersion",
      "value": ""
    },
    {
      "key": "futureStart",
      "value": ""
    },
    {
      "key": "futureEnd",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Fluxo ponta a ponta",
      "item": [
        {
          "name": "1. Cidade padrão",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities/default",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cities",
                "default"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"cityId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Categorias (pega 'shows')",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const shows = pm.response.json().find(c => c.slug === \"shows\");",
                  "pm.test(\"tem a categoria shows\", () => pm.expect(shows).to.exist);",
                  "pm.collectionVariables.set(\"categoryId\", shows.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Criar local",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/venues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "venues"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cityId\": {{cityId}},\n  \"name\": \"Sala Postman {{$timestamp}}\",\n  \"neighborhood\": \"Luz\",\n  \"postalCode\": \"01202-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"tem Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"venueId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Listar locais do bairro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/venues?neighborhood=luz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "venues"
              ],
              "query": [
                {
                  "key": "neighborhood",
                  "value": "luz"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().items.map(v => v.id);",
                  "pm.test(\"local criado aparece\", () => pm.expect(ids).to.include(pm.collectionVariables.get(\"venueId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Criar evento publicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cityId\": {{cityId}},\n  \"categoryId\": {{categoryId}},\n  \"venueId\": \"{{venueId}}\",\n  \"title\": \"Show Postman {{$timestamp}}\",\n  \"status\": \"PUBLISHED\",\n  \"priceMinCents\": 5000,\n  \"priceMaxCents\": 12000,\n  \"occurrences\": [\n    {\n      \"startsAt\": \"{{futureStart}}\",\n      \"endsAt\": \"{{futureEnd}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 30 * 24 * 3600 * 1000);",
                  "start.setUTCMinutes(0, 0, 0);",
                  "pm.collectionVariables.set(\"futureStart\", start.toISOString());",
                  "pm.collectionVariables.set(\"futureEnd\", new Date(start.getTime() + 2 * 3600 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"version 0\", () => pm.expect(body.version).to.eql(0));",
                  "pm.collectionVariables.set(\"eventId\", body.id);",
                  "pm.collectionVariables.set(\"eventVersion\", body.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Consultar evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"local e categoria vêm junto\", () => {",
                  "  pm.expect(body.venue.id).to.eql(pm.collectionVariables.get(\"venueId\"));",
                  "  pm.expect(body.category.slug).to.eql(\"shows\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Listar eventos de shows",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?category=shows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "shows"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().items.map(e => e.id);",
                  "pm.test(\"evento aparece\", () => pm.expect(ids).to.include(pm.collectionVariables.get(\"eventId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Editar evento (PUT com version)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{eventVersion}},\n  \"cityId\": {{cityId}},\n  \"categoryId\": {{categoryId}},\n  \"venueId\": \"{{venueId}}\",\n  \"title\": \"Show Postman editado {{$timestamp}}\",\n  \"status\": \"PUBLISHED\",\n  \"priceMinCents\": 5000,\n  \"priceMaxCents\": 15000,\n  \"occurrences\": [\n    {\n      \"startsAt\": \"{{futureStart}}\",\n      \"endsAt\": \"{{futureEnd}}\",\n      \"status\": \"SOLD_OUT\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const old = Number(pm.collectionVariables.get(\"eventVersion\"));",
                  "pm.test(\"version incrementada\", () => pm.expect(body.version).to.eql(old + 1));",
                  "pm.test(\"sessão esgotada\", () => pm.expect(body.occurrences[0].status).to.eql(\"SOLD_OUT\"));",
                  "pm.collectionVariables.set(\"staleVersion\", old);",
                  "pm.collectionVariables.set(\"eventVersion\", body.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "9. PUT com version antiga → 409",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{staleVersion}},\n  \"cityId\": {{cityId}},\n  \"categoryId\": {{categoryId}},\n  \"title\": \"Edição atrasada\",\n  \"status\": \"DRAFT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Excluir local com evento → 409",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/venues/{{venueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "venues",
                "{{venueId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Excluir evento",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "12. Evento excluído → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "13. Excluir local",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/venues/{{venueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "venues",
                "{{venueId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cenários de erro",
      "item": [
        {
          "name": "Local inválido → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/venues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "venues"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cityId\": {{cityId}},\n  \"name\": \"\",\n  \"postalCode\": \"01310100\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));",
                  "const fields = pm.response.json().errors.map(e => e.field);",
                  "pm.test(\"aponta name e postalCode\", () => pm.expect(fields).to.include.members([\"name\", \"postalCode\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicar sem sessão → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cityId\": {{cityId}},\n  \"categoryId\": {{categoryId}},\n  \"title\": \"Sem sessão\",\n  \"status\": \"PUBLISHED\",\n  \"occurrences\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"erro em occurrences\", () => pm.expect(pm.response.json().errors.map(e => e.field)).to.include(\"occurrences\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gratuito com preço → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cityId\": {{cityId}},\n  \"categoryId\": {{categoryId}},\n  \"title\": \"Grátis caro\",\n  \"isFree\": true,\n  \"priceMinCents\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "JSON malformado → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ isto não é json",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Id que não é UUID → 400",
          "request": {
            "method": "GET",
            "header": [],
